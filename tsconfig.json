{
  "compilerOptions": {
    /* ---- What JavaScript do we produce? ---- */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",

    /* ---- Where does code live? ---- */
    "rootDir": "src",
    "outDir": "dist",

    /* ---- Strictness: catch our bugs at compile time ---- */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    /* ---- Interop + ergonomics ---- */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* ---- Debugging support ---- */
    "declaration": true,
    "sourceMap": true,

    /* ---- Only these global type packages ---- */
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
