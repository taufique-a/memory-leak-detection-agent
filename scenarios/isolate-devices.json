{
  "schemaVersion": 1,
  "name": "isolate-devices",
  "description": "Devices <-> Clusters. The CONTROL run: same loop shape and iteration count as isolate-overview, but Overview is never mounted. If this is stable and isolate-overview grows, the growth belongs to Overview.",
  "baseUrl": "http://localhost:7400",
  "auth": { "type": "storageState", "file": ".auth/iosense.auth.json" },
  "setup": [
    { "action": "goto", "path": "/devices", "waitUntil": "domcontentloaded" },
    { "action": "waitFor", "selector": "devices", "timeoutMs": 60000 }
  ],
  "steps": [
    { "action": "click", "selector": "a.nav-link[href=\"/load-entity-gen\"]" },
    { "action": "waitFor", "selector": "load-entities-generic", "timeoutMs": 30000 },
    { "action": "click", "selector": "a.nav-link[href=\"/devices\"]" },
    { "action": "waitFor", "selector": "devices", "timeoutMs": 30000 }
  ],
  "iterations": 15,
  "warmupIterations": 3,
  "viewport": { "width": 1440, "height": 900 },
  "timeoutMs": 60000
}
